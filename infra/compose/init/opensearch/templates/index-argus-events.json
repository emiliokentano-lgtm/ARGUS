{
  "index_patterns": ["argus-events-*"],
  "composed_of": ["argus-base-settings"],
  "priority": 100,
  "template": {
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "event_id":         { "type": "keyword" },
        "schema_version":   { "type": "keyword" },
        "type":             { "type": "keyword" },
        "title":            { "type": "text", "fields": { "raw": { "type": "keyword", "ignore_above": 512 } } },
        "summary":          { "type": "text" },
        "lang":             { "type": "keyword" },
        "occurred_at":      { "type": "date" },
        "observed_at":      { "type": "date" },
        "ingested_at":      { "type": "date" },
        "status":           { "type": "keyword" },
        "severity":         { "type": "float" },
        "confidence":       { "type": "float" },
        "priority":         { "type": "float" },
        "geo_point":        { "type": "geo_point" },
        "geo_shape":        { "type": "geo_shape" },
        "geo_precision":    { "type": "keyword" },
        "h3_r5":            { "type": "keyword" },
        "h3_r7":            { "type": "keyword" },
        "place_name":       { "type": "text", "fields": { "raw": { "type": "keyword", "ignore_above": 256 } } },
        "country":          { "type": "keyword" },
        "entity_ids":       { "type": "keyword" },
        "source_id":        { "type": "keyword" },
        "source_reliability": { "type": "keyword" },
        "story_cluster_id": { "type": "keyword" },
        "tags":             { "type": "keyword" }
      }
    }
  },
  "_meta": {
    "description": "Ereignisse fuer Volltext- und Geosuche. dynamic=strict, damit ein Feld, das das Schema nicht kennt, auffaellt statt still zu landen."
  },
  "version": 1
}
