# ARGUS — Konfiguration des lokalen Entwicklungs-Stacks
#
# Kopieren nach .env ("make up" tut das automatisch, falls .env fehlt) und bei
# Bedarf anpassen. .env ist in .gitignore und gehoert nie ins Repository.
#
# ACHTUNG: Die Zugangsdaten hier sind Entwicklungswerte. Sie sind bewusst
# schwach und bewusst oeffentlich. Fuer staging/prod kommen sie aus dem
# Secret-Manager (Kapitel 13), nie aus einer .env-Datei.

# ---------------------------------------------------------------------------
# Allgemein
# ---------------------------------------------------------------------------

# Praefix aller Container-, Volume- und Netzwerknamen.
COMPOSE_PROJECT_NAME=argus

# Zeitzone der Container. UTC ueberall - ARGUS rechnet ausschliesslich in UTC.
TZ=UTC

# ---------------------------------------------------------------------------
# PostgreSQL (PostGIS + TimescaleDB + pgvector)
# ---------------------------------------------------------------------------

# Postgres-Image. Der Standardwert steht in docker-compose.yml und bringt
# PostGIS, TimescaleDB und pgvector mit - aber kein Apache AGE. Wer den
# Graph-Layer braucht (Phase 5), baut das Image mit AGE und traegt es hier ein:
#   make postgres-age-build
# POSTGRES_IMAGE=argus/postgres-age:local

POSTGRES_USER=argus
POSTGRES_PASSWORD=argus_dev_only
POSTGRES_DB=argus
POSTGRES_PORT=5432

# Datenverzeichnis IM CONTAINER. Das timescaledb-ha-Image legt PGDATA unter
# /home/postgres/pgdata/data ab, nicht unter /var/lib/postgresql/data.
# Bei einem Imagewechsel diesen Wert mit anpassen:
#   docker compose exec postgres printenv PGDATA
POSTGRES_DATA_DIR=/home/postgres/pgdata

# Speicherobergrenze des Containers.
POSTGRES_MEM_LIMIT=2g
POSTGRES_CPUS=2.0

# ---------------------------------------------------------------------------
# ClickHouse
# ---------------------------------------------------------------------------

CLICKHOUSE_USER=argus
CLICKHOUSE_PASSWORD=argus_dev_only
CLICKHOUSE_DB=argus

# HTTP-Schnittstelle (Abfragen, Health).
CLICKHOUSE_HTTP_PORT=8123
# Natives Protokoll (clickhouse-client, schnellere Clients).
CLICKHOUSE_NATIVE_PORT=9000
# Prometheus-Endpunkt (nativ, ohne Exporter).
CLICKHOUSE_METRICS_PORT=9363

CLICKHOUSE_MEM_LIMIT=2g
CLICKHOUSE_CPUS=2.0

# ---------------------------------------------------------------------------
# NATS JetStream
# ---------------------------------------------------------------------------

NATS_CLIENT_PORT=4222
NATS_MONITOR_PORT=8222

# Obergrenzen des JetStream-Speichers. Verhindert, dass ein Backfill die
# Entwicklerplatte fuellt.
NATS_JS_MAX_MEMORY=512M
NATS_JS_MAX_FILE=4G

NATS_MEM_LIMIT=512m
NATS_CPUS=1.0

# ---------------------------------------------------------------------------
# Valkey (Cache, Hot State, Geo-Kommandos)
# ---------------------------------------------------------------------------

VALKEY_PASSWORD=argus_dev_only
VALKEY_PORT=6379
# Obergrenze des Datensatzspeichers; darunter greift die Verdraengung.
VALKEY_MAXMEMORY=256mb

VALKEY_MEM_LIMIT=512m
VALKEY_CPUS=1.0

# ---------------------------------------------------------------------------
# MinIO (Bronze-Layer, Exporte)
# ---------------------------------------------------------------------------

MINIO_ROOT_USER=argus
# Mindestens 8 Zeichen, sonst startet MinIO nicht.
MINIO_ROOT_PASSWORD=argus_dev_only

# S3-API. Bewusst NICHT 9000 - dort liegt das native ClickHouse-Protokoll.
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9001

# Buckets, die beim Start angelegt werden (durch Leerzeichen getrennt).
# In Anfuehrungszeichen, weil der Wert Leerzeichen enthaelt: Compose entfernt
# sie beim Einlesen, und die Shell-Skripte koennen die Datei so ebenfalls
# mit "source" laden.
MINIO_BUCKETS="argus-bronze argus-exports"

MINIO_MEM_LIMIT=1g
MINIO_CPUS=1.0

# ---------------------------------------------------------------------------
# OpenSearch (Volltext + Vektor)
# ---------------------------------------------------------------------------

OPENSEARCH_PORT=9200
# Heap. Faustregel: die Haelfte des Container-Limits, hoechstens 31g.
OPENSEARCH_JAVA_OPTS="-Xms1g -Xmx1g"

OPENSEARCH_MEM_LIMIT=2g
OPENSEARCH_CPUS=2.0

# ---------------------------------------------------------------------------
# Prometheus / Grafana
# ---------------------------------------------------------------------------

PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
PROMETHEUS_MEM_LIMIT=1g
PROMETHEUS_CPUS=1.0

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=argus_dev_only
GRAFANA_MEM_LIMIT=512m
GRAFANA_CPUS=1.0
