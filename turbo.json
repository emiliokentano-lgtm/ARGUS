{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", "eslint.config.mjs", ".prettierrc.json"],
  "globalEnv": ["CI"],
  "tasks": {
    "generate": {
      "inputs": ["proto/**", "buf.gen.ts.yaml", "buf.yaml"],
      "outputs": ["gen/ts/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "generate"],
      "inputs": ["src/**", "gen/ts/**", "tsconfig.json", "$TURBO_DEFAULT$"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["src/**", "eslint.config.mjs", "$TURBO_DEFAULT$"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["coverage/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**", "gen/**"]
    }
  }
}
